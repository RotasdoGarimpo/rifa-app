# The web app's NEXT_PUBLIC_SERVER_URL points here, and CORS_ORIGIN points back
# at the web app. Changing one port means changing the other.
PORT=3333
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/rifa-app

# Organizer WhatsApp (digits only, with country code) and the PIX key buyers pay to.
ADMIN_WHATSAPP=5511988887777
PIX_KEY=rifa@violacaipira.com.br

# Argon2 hash of the admin PIN. Generate with:
#   bun -e 'console.log(await Bun.password.hash("1234"))'
# IMPORTANT: .env expands "$", so escape every one as "\$" or the hash loads
# mangled and login fails with "UnsupportedAlgorithm".
ADMIN_PIN_HASH=\$argon2id\$v=19\$m=65536,t=2,p=1\$...
# 32+ chars. Rotating this logs every admin out.
#   bun -e 'console.log(crypto.randomUUID() + crypto.randomUUID())'
SESSION_SECRET=change-me-to-a-long-random-string-32chars
