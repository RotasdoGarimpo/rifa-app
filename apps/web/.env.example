# Where apps/server listens. Must match PORT in apps/server/.env.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# UploadThing (prize photos). Get a token at https://uploadthing.com/dashboard
# Uploads are disabled until this is set.
UPLOADTHING_TOKEN=

# Must be byte-identical to apps/server/.env: the server signs the admin
# cookie, this app verifies it for uploads.
SESSION_SECRET=change-me-to-a-long-random-string-32chars
