{
	"name": "rifa-app",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.4.2",
			"zod": "^4.4.3",
			"typescript": "^6.0.3",
			"@types/bun": "^1.3.14",
			"elysia": "^1.4.29",
			"@orpc/server": "^1.14.12",
			"@orpc/openapi": "^1.14.12",
			"@orpc/zod": "^1.14.12",
			"lucide-react": "^1.27.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.8",
			"react-dom": "^19.2.8",
			"sonner": "^2.0.7",
			"@orpc/client": "^1.14.12",
			"@tailwindcss/postcss": "^4.3.3",
			"@types/react": "^19.2.17",
			"@types/react-dom": "^19.2.3",
			"tailwindcss": "^4.3.3"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"start:web": "bun run -F web start",
		"start:server": "bun run -F server start",
		"check-types": "turbo run check-types",
		"dev:server": "turbo run dev -F server",
		"dev:web": "turbo run dev -F web",
		"db:push": "turbo run db:push -F @rifa-app/db",
		"db:studio": "turbo run db:studio -F @rifa-app/db",
		"db:generate": "turbo run db:generate -F @rifa-app/db",
		"db:migrate": "turbo run db:migrate -F @rifa-app/db",
		"db:start": "turbo run db:start -F @rifa-app/db",
		"db:watch": "turbo run db:watch -F @rifa-app/db",
		"db:stop": "turbo run db:stop -F @rifa-app/db",
		"db:down": "turbo run db:down -F @rifa-app/db",
		"check": "biome check --write ."
	},
	"dependencies": {
		"@rifa-app/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@rifa-app/config": "workspace:*",
		"@types/bun": "catalog:",
		"lefthook": "^2.1.10",
		"turbo": "^2.10.7",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.3.14"
}
