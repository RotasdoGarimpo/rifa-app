{
  "name": "rifa-app",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/bun": "^1.3.14",
      "elysia": "^1.4.29",
      "@orpc/server": "^1.14.12",
      "@orpc/openapi": "^1.14.12",
      "@orpc/zod": "^1.14.12"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:server": "turbo run dev -F server",
    "db:push": "turbo run db:push -F @rifa-app/db",
    "db:studio": "turbo run db:studio -F @rifa-app/db",
    "db:generate": "turbo run db:generate -F @rifa-app/db",
    "db:migrate": "turbo run db:migrate -F @rifa-app/db",
    "db:local": "turbo run db:local -F @rifa-app/db",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@rifa-app/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@rifa-app/config": "workspace:*",
    "@types/bun": "catalog:",
    "lefthook": "^2.1.10",
    "turbo": "^2.10.7",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
