# apps/server listens here; apps/web's NEXT_PUBLIC_SERVER_URL must point at it,
# and CORS_ORIGIN must point back at apps/web's origin.
PORT=3333
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3333
DATABASE_URL=postgresql://postgres:password@localhost:5432/rifa-app

# Organizer WhatsApp (digits only, with country code) and the PIX key buyers pay to.
ADMIN_WHATSAPP=554799236971
PIX_KEY=4799236971

# Plaintext 6-digit admin PIN.
ADMIN_PIN=123456

# 32+ chars. Rotating this logs every admin out. Shared byte-for-byte between
# apps/server (signs the admin cookie) and apps/web (verifies it for uploads).
SESSION_SECRET=change-me-to-a-long-random-string-32chars

# UploadThing (prize photos). Get a token at https://uploadthing.com/dashboard
# Uploads are disabled until this is set.
UPLOADTHING_TOKEN=
